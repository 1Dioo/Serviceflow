<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.serviceflow.controller.DashboardController"
      styleClass="dashboard"
      spacing="28">

    <!-- CABEÇALHO -->

    <HBox alignment="CENTER_LEFT">

        <VBox spacing="5">

            <Label text="Dashboard"
                   styleClass="page-title"/>

            <Label text="Visão geral do seu negócio"
                   styleClass="page-subtitle"/>

        </VBox>

        <Region HBox.hgrow="ALWAYS"/>

        <VBox alignment="CENTER_RIGHT"
              spacing="3">

            <Label text="26 de setembro de 2026"
                   styleClass="date"/>

            <Label text="Hoje"
                   styleClass="date-label"/>

        </VBox>

    </HBox>


    <!-- ÁREA DE BOAS-VINDAS -->

    <VBox styleClass="welcome-card"
          spacing="8">

        <Label text="Bem-vindo ao ServiceFlow"
               styleClass="welcome-title"/>

        <Label text="Gerencie seus serviços, clientes e agendamentos de forma simples e organizada."
               styleClass="welcome-description"/>

        <HBox alignment="CENTER_LEFT"
              spacing="10">

            <Label text="Desenvolvido por Diogo Rodrigues"
                   styleClass="welcome-author"/>

            <Button text="GitHub"
                    fx:id="githubButton"
                    onAction="#handleGitHub"
                    styleClass="github-button"/>

        </HBox>

    </VBox>


    <!-- CARDS DE ESTATÍSTICAS -->

    <HBox spacing="18">

        <VBox styleClass="stat-card"
              HBox.hgrow="ALWAYS">

            <Label text="AGENDAMENTOS HOJE"
                   styleClass="stat-label"/>

            <Label text="0"
                   styleClass="stat-value"/>

            <Label text="Agendamentos previstos"
                   styleClass="stat-description"/>

        </VBox>


        <VBox styleClass="stat-card"
              HBox.hgrow="ALWAYS">

            <Label text="CLIENTES"
                   styleClass="stat-label"/>

            <Label text="0"
                   styleClass="stat-value"/>

            <Label text="Clientes cadastrados"
                   styleClass="stat-description"/>

        </VBox>


        <VBox styleClass="stat-card"
              HBox.hgrow="ALWAYS">

            <Label text="SERVIÇOS"
                   styleClass="stat-label"/>

            <Label text="0"
                   styleClass="stat-value"/>

            <Label text="Serviços ativos"
                   styleClass="stat-description"/>

        </VBox>

    </HBox>


    <!-- CONTEÚDO INFERIOR -->

    <HBox spacing="20"
          VBox.vgrow="ALWAYS">


        <!-- PRÓXIMOS AGENDAMENTOS -->

        <VBox styleClass="panel"
              spacing="18"
              HBox.hgrow="ALWAYS">

            <HBox alignment="CENTER_LEFT">

                <VBox spacing="3">

                    <Label text="Próximos agendamentos"
                           styleClass="panel-title"/>

                    <Label text="Compromissos de hoje"
                           styleClass="panel-subtitle"/>

                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Label text="Ver agenda"
                       styleClass="panel-action"/>

            </HBox>
        </VBox>


        <!-- RESUMO DO DIA -->

        <VBox styleClass="panel summary-panel"
              spacing="20">

            <VBox spacing="3">

                <Label text="Resumo do dia"
                       styleClass="panel-title"/>

                <Label text="Status dos atendimentos"
                       styleClass="panel-subtitle"/>

            </VBox>
        </VBox>
    </HBox>
</VBox>