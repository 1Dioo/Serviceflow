<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.serviceflow.controller.ServicosController"
            stylesheets="@../css/style.css"
            styleClass="servicos-page">

    <top>

        <VBox spacing="5">

            <Label text="Serviços"
                   styleClass="page-title"/>

            <Label text="Gerencie os serviços de TI oferecidos pela sua empresa."
                   styleClass="page-subtitle"/>

            <padding>
                <Insets top="30" right="30" bottom="20" left="30"/>
            </padding>

        </VBox>

    </top>

    <center>

        <VBox spacing="15">

            <HBox spacing="10"
                  alignment="CENTER_LEFT">

                <TextField fx:id="searchField"
                           promptText="Pesquisar serviço..."
                           styleClass="search-field"
                           HBox.hgrow="ALWAYS"/>

                <Button text="+ Novo serviço"
                        styleClass="primary-button"
                        onAction="#handleNewService"/>

            </HBox>

            <ScrollPane fitToWidth="true"
                        fitToHeight="true"
                        styleClass="services-scroll">

                <VBox fx:id="servicesContainer"
                      spacing="8"
                      styleClass="services-list"/>

            </ScrollPane>

            <padding>
                <Insets top="0" right="30" bottom="30" left="30"/>
            </padding>

        </VBox>

    </center>

</BorderPane>