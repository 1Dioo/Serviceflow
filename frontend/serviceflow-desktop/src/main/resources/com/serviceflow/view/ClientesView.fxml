<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.serviceflow.controller.ClientesController"
      styleClass="clientes-page"
      spacing="24">

    <!-- CABEÇALHO -->

    <HBox alignment="CENTER_LEFT">

        <VBox spacing="5">

            <Label text="Clientes"
                   styleClass="page-title"/>

            <Label text="Gerencie os clientes cadastrados"
                   styleClass="page-subtitle"/>

        </VBox>

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="+ Novo cliente"
                onAction="#handleNewClient"
                styleClass="primary-button"/>

    </HBox>


    <!-- PESQUISA -->

    <HBox alignment="CENTER_LEFT"
          spacing="12"
          styleClass="client-search">

        <TextField fx:id="searchField"
                   promptText="Pesquisar por nome ou telefone..."
                   styleClass="search-field"
                   HBox.hgrow="ALWAYS"/>

        <Label fx:id="clientCountLabel"
               text="0 clientes"
               styleClass="client-count"/>

    </HBox>


    <!-- LISTA DE CLIENTES -->

    <VBox styleClass="clients-panel"
          spacing="0"
          VBox.vgrow="ALWAYS">

        <!-- CABEÇALHO DA LISTA -->

        <HBox styleClass="client-header"
              alignment="CENTER_LEFT">

            <Label text="Cliente"
                   styleClass="client-header-label"
                   maxWidth="Infinity"
                   HBox.hgrow="ALWAYS"/>

            <Label text="Telefone"
                   styleClass="client-header-label"
                   prefWidth="150"/>

            <Label text="E-mail"
                   styleClass="client-header-label"
                   prefWidth="220"/>

            <Label text="Ações"
                   styleClass="client-header-label"
                   prefWidth="150"/>

        </HBox>


        <!-- CLIENTES -->

        <VBox fx:id="clientsContainer"
              spacing="0"
              VBox.vgrow="ALWAYS"/>

    </VBox>

</VBox>