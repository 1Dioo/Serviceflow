<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.serviceflow.controller.admin.NewEmployeeController"
      stylesheets="@../css/style.css"
      styleClass="employee-form"
      spacing="12"
      prefWidth="500">

    <padding>
        <Insets top="25" right="30" bottom="25" left="30"/>
    </padding>

    <VBox spacing="4">
        <Label text="Novo funcionário"
               styleClass="form-title"/>

        <Label text="Preencha as informações do profissional."
               styleClass="form-subtitle"/>
    </VBox>

    <VBox spacing="6">
        <Label text="Nome completo" styleClass="field-label"/>
        <TextField fx:id="nameField"
                   promptText="Nome do funcionário"
                   styleClass="form-field"/>
    </VBox>

    <VBox spacing="6">
        <Label text="Contato" styleClass="field-label"/>
        <TextField fx:id="contactField"
                   promptText="Telefone ou e-mail"
                   styleClass="form-field"/>
    </VBox>

    <VBox spacing="6">
        <Label text="Formação / Escolaridade" styleClass="field-label"/>
        <TextField fx:id="educationField"
                   promptText="Ex.: Técnico em Desenvolvimento de Sistemas"
                   styleClass="form-field"/>
    </VBox>

    <VBox spacing="6">
        <Label text="Área de atuação" styleClass="field-label"/>
        <ComboBox fx:id="areaComboBox"
                  promptText="Selecione a área"
                  maxWidth="Infinity"
                  styleClass="form-field"/>
    </VBox>

    <VBox spacing="6">
        <Label text="Especialidades" styleClass="field-label"/>
        <TextField fx:id="specialtiesField"
                   promptText="Ex.: Sites, sistemas, aplicativos"
                   styleClass="form-field"/>
    </VBox>

    <HBox spacing="10">
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Experiência" styleClass="field-label"/>
            <TextField fx:id="experienceField"
                       promptText="Ex.: 2 anos"
                       styleClass="form-field"/>
        </VBox>

        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Status" styleClass="field-label"/>
            <ComboBox fx:id="statusComboBox"
                      promptText="Selecione o status"
                      maxWidth="Infinity"
                      styleClass="form-field"/>
        </VBox>
    </HBox>

    <Region VBox.vgrow="ALWAYS"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">

        <Button text="Cancelar"
                onAction="#handleCancel"
                styleClass="secondary-button"/>

        <Button text="Cadastrar funcionário"
                onAction="#handleSave"
                styleClass="primary-button"/>

    </HBox>

</VBox>
