<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
    Funcionários (painel administrativo). Usa as classes do tema:
    títulos de página, cartões de indicador do Dashboard, campo de busca,
    tabela padrão e botões primário/perigo.
-->
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.serviceflow.controller.admin.EmployeesController"
      spacing="20"
      styleClass="employees-page">

    <HBox alignment="CENTER_LEFT" spacing="16">
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Funcionários"
                   styleClass="page-title"/>

            <Label text="Gerencie os profissionais cadastrados no ServiceFlow."
                   styleClass="page-subtitle"/>
        </VBox>

        <Button text="+ Novo funcionário"
                onAction="#handleNewEmployee"
                styleClass="primary-button"/>
    </HBox>

    <HBox spacing="16">
        <VBox spacing="6"
              HBox.hgrow="ALWAYS"
              styleClass="stat-card">
            <Label text="TOTAL DE FUNCIONÁRIOS"
                   styleClass="stat-label"/>

            <Label fx:id="totalLabel"
                   text="0"
                   styleClass="stat-value"/>
        </VBox>

        <VBox spacing="6"
              HBox.hgrow="ALWAYS"
              styleClass="stat-card">
            <Label text="FUNCIONÁRIOS ATIVOS"
                   styleClass="stat-label"/>

            <Label fx:id="activeLabel"
                   text="0"
                   styleClass="stat-value"/>
        </VBox>
    </HBox>

    <TextField fx:id="searchField"
               promptText="Pesquisar por nome ou área de atuação..."
               onKeyReleased="#handleSearch"
               styleClass="search-field"/>

    <TableView fx:id="employeeTable"
               VBox.vgrow="ALWAYS">

        <columns>

            <TableColumn fx:id="nameColumn"
                         text="Nome"
                         prefWidth="170"/>

            <TableColumn fx:id="contactColumn"
                         text="Contato"
                         prefWidth="130"/>

            <TableColumn fx:id="areaColumn"
                         text="Área"
                         prefWidth="120"/>

            <TableColumn fx:id="educationColumn"
                         text="Formação"
                         prefWidth="140"/>

            <TableColumn fx:id="experienceColumn"
                         text="Experiência"
                         prefWidth="110"/>

            <TableColumn fx:id="statusColumn"
                         text="Status"
                         prefWidth="90"/>

        </columns>

        <placeholder>
            <Label text="Nenhum funcionário cadastrado ainda."/>
        </placeholder>

    </TableView>

    <HBox alignment="CENTER_RIGHT">
        <Button text="Remover selecionado"
                onAction="#handleRemoveEmployee"
                styleClass="danger-button"/>
    </HBox>

</VBox>
