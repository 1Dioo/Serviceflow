<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.serviceflow.controller.NewAppointmentController"
      styleClass="appointment-form"
      spacing="10">

    <padding>
        <Insets top="25"
                right="30"
                bottom="25"
                left="30"/>
    </padding>

    <VBox spacing="4">

        <Label text="Novo agendamento"
               styleClass="form-title"/>

        <Label text="Preencha os dados do atendimento"
               styleClass="form-subtitle"/>

    </VBox>


    <VBox spacing="6">

        <Label text="Cliente"
               styleClass="field-label"/>

        <TextField fx:id="clientField"
                   promptText="Nome do cliente"
                   styleClass="form-field"/>

    </VBox>


    <VBox spacing="6">

        <Label text="Serviço"
               styleClass="field-label"/>

        <TextField fx:id="serviceField"
                   promptText="Serviço a realizar"
                   styleClass="form-field"/>

    </VBox>


    <VBox spacing="6">

        <Label text="Data"
               styleClass="field-label"/>

        <DatePicker fx:id="datePicker"
                    styleClass="form-field"
                    maxWidth="Infinity"/>

    </VBox>


    <VBox spacing="6">

        <Label text="Horário"
               styleClass="field-label"/>

        <ComboBox fx:id="timeComboBox"
                  promptText="Selecione o horário"
                  maxWidth="Infinity"
                  styleClass="form-field"/>

    </VBox>


    <Label fx:id="messageLabel"
           styleClass="form-message"
           visible="false"
           managed="false"/>


    <Button text="Salvar agendamento"
            fx:id="saveButton"
            maxWidth="Infinity"
            onAction="#handleSave"
            styleClass="primary-button"/>


    <Button text="Cancelar"
            onAction="#handleCancel"
            maxWidth="Infinity"
            styleClass="secondary-button"/>

</VBox>