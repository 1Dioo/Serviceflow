<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.serviceflow.controller.admin.AdminLoginController"
           stylesheets="@../css/style.css"
           styleClass="login-page">

    <VBox styleClass="login-card"
          spacing="18"
          alignment="CENTER">

        <padding>
            <Insets top="30"
                    right="40"
                    bottom="30"
                    left="40"/>
        </padding>


        <!-- IDENTIDADE -->

        <VBox alignment="CENTER"
              spacing="6">

            <Label text="ServiceFlow"
                   styleClass="login-logo"/>

            <Label text="Acesso administrativo"
                   styleClass="login-title"/>

            <Label text="Entre com uma conta de administrador"
                   styleClass="login-subtitle"/>

        </VBox>


        <!-- CAMPOS -->

        <VBox spacing="8">

            <Label text="Usuário administrador"
                   styleClass="field-label"/>

            <TextField fx:id="usernameField"
                       promptText="Digite o usuário"
                       styleClass="login-field"/>

        </VBox>


        <VBox spacing="8">

            <Label text="Senha"
                   styleClass="field-label"/>

            <PasswordField fx:id="passwordField"
                           promptText="Digite a senha"
                           styleClass="login-field"/>

        </VBox>


        <!-- MENSAGEM -->

        <Label fx:id="messageLabel"
               styleClass="login-message"
               wrapText="true"
               maxWidth="Infinity"
               visible="false"
               managed="false"/>


        <!-- AÇÕES -->

        <Button text="Entrar como administrador"
                fx:id="loginButton"
                maxWidth="Infinity"
                defaultButton="true"
                onAction="#handleLogin"
                styleClass="login-button"/>

        <Button text="Cancelar"
                fx:id="cancelButton"
                cancelButton="true"
                onAction="#handleCancel"
                styleClass="register-button"/>

    </VBox>

</StackPane>
