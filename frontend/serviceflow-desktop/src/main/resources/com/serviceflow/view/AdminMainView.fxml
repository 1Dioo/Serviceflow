<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
    Painel administrativo: mesma estrutura visual da janela principal
    (MainView): barra lateral .sidebar, itens .nav-item e área de conteúdo
    escura, sem moldura clara em volta das telas.
-->
<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.serviceflow.controller.admin.AdminMainController"
            prefWidth="1200"
            prefHeight="750"
            stylesheets="@../css/style.css"
            styleClass="app">

    <left>
        <VBox styleClass="sidebar">

            <VBox spacing="3"
                  styleClass="logo-area">

                <Label text="ServiceFlow"
                       styleClass="logo"/>

                <Label text="Painel administrativo"
                       styleClass="logo-subtitle"/>

            </VBox>

            <VBox spacing="6"
                  styleClass="nav">

                <Label text="GERENCIAMENTO"
                       styleClass="nav-section-label"/>

                <Button fx:id="dashboardButton"
                        text="Dashboard"
                        onAction="#showDashboard"
                        styleClass="nav-item"/>

                <Button fx:id="agendaButton"
                        text="Agenda"
                        onAction="#showAgenda"
                        styleClass="nav-item"/>

                <Button fx:id="clientsButton"
                        text="Clientes"
                        onAction="#showClients"
                        styleClass="nav-item"/>

                <Button fx:id="servicesButton"
                        text="Serviços"
                        onAction="#showServices"
                        styleClass="nav-item"/>

                <Label text="ADMINISTRAÇÃO"
                       styleClass="nav-section-label"/>

                <Button fx:id="employeesButton"
                        text="Funcionários"
                        onAction="#showEmployees"
                        styleClass="nav-item"/>

                <Button fx:id="reportsButton"
                        text="Relatórios"
                        onAction="#showReports"
                        styleClass="nav-item"/>

                <Button fx:id="settingsButton"
                        text="Configurações"
                        onAction="#showSettings"
                        styleClass="nav-item"/>

            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox spacing="8"
                  styleClass="sidebar-footer">

                <Button text="Sair da conta"
                        onAction="#handleLogout"
                        maxWidth="Infinity"
                        styleClass="sidebar-logout"/>

                <VBox spacing="2"
                      styleClass="sidebar-info">

                    <Label text="ServiceFlow"
                           styleClass="sidebar-info-title"/>

                    <Label text="Modo administrador"
                           styleClass="sidebar-info-text"/>

                </VBox>

            </VBox>

        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentArea"
                   styleClass="content-area"/>
    </center>

</BorderPane>
