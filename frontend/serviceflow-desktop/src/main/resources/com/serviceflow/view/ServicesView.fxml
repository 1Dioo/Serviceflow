<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.serviceflow.controller.ServicesController"
            stylesheets="@../css/style.css"
            styleClass="servicos-page">

    <top>
        <HBox alignment="CENTER_LEFT">
            <VBox spacing="5">
                <Label text="Serviços"
                       styleClass="page-title"/>

                <Label text="Gerencie o catálogo de serviços e os atendimentos agendados."
                       styleClass="page-subtitle"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="+ Novo serviço"
                    onAction="#handleNewService"
                    styleClass="primary-button"/>

            <padding>
                <Insets top="30"
                        right="30"
                        bottom="20"
                        left="30"/>
            </padding>
        </HBox>
    </top>

    <center>
        <VBox spacing="15">

            <TextField fx:id="searchField"
                       promptText="Pesquisar por serviço, cliente ou categoria..."
                       styleClass="search-field"/>

            <ScrollPane fitToWidth="true"
                        VBox.vgrow="ALWAYS"
                        styleClass="services-scroll">

                <VBox spacing="10"
                      styleClass="services-list">

                    <!-- CATÁLOGO -->
                    <Label text="Catálogo de serviços"
                           styleClass="services-section-title"/>

                    <VBox fx:id="catalogContainer"
                          spacing="8"
                          styleClass="services-list"/>

                    <!-- ATENDIMENTOS -->
                    <Label text="Atendimentos agendados"
                           styleClass="services-section-title"/>

                    <VBox fx:id="servicesContainer"
                          spacing="8"
                          styleClass="services-list"/>

                </VBox>

            </ScrollPane>

            <padding>
                <Insets top="0"
                        right="30"
                        bottom="30"
                        left="30"/>
            </padding>

        </VBox>
    </center>

</BorderPane>
