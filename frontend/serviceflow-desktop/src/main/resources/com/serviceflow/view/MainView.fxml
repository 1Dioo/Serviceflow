<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.serviceflow.controller.MainController"
            stylesheets="@../css/style.css"
            styleClass="app">

    <!-- SIDEBAR -->
    <left>

        <VBox styleClass="sidebar">

            <!-- LOGO -->
            <VBox spacing="3"
                  styleClass="logo-area">

                <Label text="ServiceFlow"
                       styleClass="logo"/>

                <Label text="Gestão de serviços"
                       styleClass="logo-subtitle"/>

            </VBox>

            <!-- MENU -->
            <VBox spacing="6"
                  styleClass="nav">

                <Label fx:id="dashboardMenuItem"
                       text="Dashboard"
                       onMouseClicked="#handleDashboard"
                       styleClass="nav-item"/>

                <Label fx:id="agendaMenuItem"
                       text="Agenda"
                       onMouseClicked="#handleAgenda"
                       styleClass="nav-item"/>

                <Label fx:id="clientsMenuItem"
                       text="Clientes"
                       onMouseClicked="#handleClientes"
                       styleClass="nav-item"/>

                <Label fx:id="servicesMenuItem"
                       text="Serviços"
                       onMouseClicked="#handleServicos"
                       styleClass="nav-item"/>

                <Label fx:id="professionalsMenuItem"
                       text="Profissionais"
                       onMouseClicked="#handleProfissionais"
                       styleClass="nav-item"/>

                <Label fx:id="reportsMenuItem"
                       text="Relatórios"
                       onMouseClicked="#handleRelatorios"
                       styleClass="nav-item"/>

            </VBox>

            <!-- ESPAÇO -->
            <Region VBox.vgrow="ALWAYS"/>

            <!-- RODAPÉ -->
            <VBox spacing="8"
                  styleClass="sidebar-footer">

                <Label fx:id="settingsMenuItem"
                       text="Configurações"
                       onMouseClicked="#handleSettings"
                       styleClass="nav-item"/>

                <!-- SAIR DA CONTA -->
                <Button text="Sair da conta"
                        onAction="#handleLogout"
                        maxWidth="Infinity"
                        styleClass="sidebar-logout"/>

                <!-- INFORMAÇÕES -->
                <VBox spacing="2"
                      styleClass="sidebar-info">

                    <Label text="ServiceFlow"
                           styleClass="sidebar-info-title"/>

                    <Label text="v3.6.1 • Em desenvolvimento"
                           styleClass="sidebar-info-text"/>

                </VBox>

            </VBox>

        </VBox>

    </left>

    <!-- ÁREA PRINCIPAL -->
    <center>

        <VBox fx:id="contentArea"
              styleClass="content-area"/>

    </center>

</BorderPane>
